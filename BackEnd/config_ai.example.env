# Salin ke config_ai.env — pilih SATU provider (nvidia / openrouter / 9router)

# ---------- NVIDIA NIM (Developer Program — disarankan) ----------
# API key: https://build.nvidia.com → masuk → API Keys
# Model: https://build.nvidia.com/explore/discover → pilih model → lihat ID (contoh meta/llama-3.1-8b-instruct)

AI_PROVIDER=nvidia
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AI_MODEL=meta/llama-3.1-8b-instruct

# ---------- OpenRouter ----------
# AI_PROVIDER=openrouter
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=sk-or-v1-xxxxxxxx
# AI_MODEL=openai/gpt-4o-mini
# AI_SITE_URL=http://localhost:5000
# AI_SITE_NAME=Toko Sembako

# ---------- 9Router (lokal) ----------
# AI_PROVIDER=9router
# AI_BASE_URL=http://localhost:20128/v1
# AI_API_KEY=api_key_dari_9router
# AI_MODEL=gpt-4o-mini
