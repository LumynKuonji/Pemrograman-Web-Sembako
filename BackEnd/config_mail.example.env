# =========================================================================
# TEMPLATE RESMI KONFIGURASI EMAIL - TOKO SEMBAKO (BREVO HTTP API)
# =========================================================================
#
# Berkas ini digunakan sebagai acuan konfigurasi email pada proyek.
#
# Penggunaan:
# 1. Local Development        : Salin berkas ini ke ".env" atau "config_mail.env" di folder BackEnd,
#                               lalu isi variabel sesuai kebutuhan.
# 2. Production (Railway)     : Atur Environment Variables langsung melalui Dashboard Railway.
#
# Catatan Keamanan:
# JANGAN pernah menyimpan atau men-commit kredensial asli (API Key) ke Git!
#
# =========================================================================

# Provider email yang didukung:
# - console : (Fallback) Email tidak dikirim, hanya disimpan/di-log ke database (sangat cocok untuk dev/test).
# - brevo   : Mengirim email nyata menggunakan Brevo HTTP API (kompatibel dengan Railway Free).
MAIL_PROVIDER=console

# API Key Brevo
# Dapatkan dari dashboard Brevo: SMTP & API -> API Keys (dimulai dengan xkeysib-...)
BREVO_API_KEY=your_brevo_api_key_here

# Alamat pengirim default yang tampil di inbox penerima
# Format: Nama Pengirim <email@domain.com>
# Pastikan alamat email di bawah ini sudah dideklarasikan dan diverifikasi sebagai Sender di Brevo.
MAIL_DEFAULT_SENDER=Toko Sembako <noreply@tokosembako.com>

# --- Fitur Tambahan (Development) ---
# Jika diisi, semua email keluar akan diarahkan ke alamat ini (sangat berguna untuk tes pengiriman lokal)
# Kosongkan di production.
MAIL_REDIRECT_TO=
