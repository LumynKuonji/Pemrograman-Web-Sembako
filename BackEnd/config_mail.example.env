# =========================================================================
# TEMPLATE RESMI KONFIGURASI EMAIL - TOKO SEMBAKO
# =========================================================================
#
# Berkas ini digunakan sebagai acuan konfigurasi email pada proyek.
#
# Penggunaan:
# 1. config_mail.example.env  : Contoh/template konfigurasi resmi (JANGAN diubah).
# 2. config_mail.env          : Konfigurasi lokal development (JANGAN di-commit ke Git).
#                               Salin berkas ini ke "config_mail.env" untuk development lokal.
# 3. Railway Environment Variables: Konfigurasi untuk production (diatur di Dashboard Railway).
#
# =========================================================================

# Provider email yang didukung:
# - console : (Fallback) Email tidak dikirim, hanya disimpan/di-log ke database (sangat cocok untuk dev/test).
# - smtp    : Mengirim email nyata menggunakan server SMTP (contoh: Brevo SMTP).
MAIL_PROVIDER=console

# --- Konfigurasi SMTP (Hanya jika MAIL_PROVIDER=smtp) ---
# Contoh di bawah ini dikonfigurasi untuk menggunakan SMTP Brevo
MAIL_SMTP_SERVER=smtp-relay.brevo.com
MAIL_SMTP_PORT=587
MAIL_USE_TLS=True

# Kredensial SMTP Brevo
# Masukkan username (biasanya alamat email akun Brevo) dan password SMTP Anda
MAIL_USERNAME=username_brevo_anda@domain.com
MAIL_PASSWORD=smtp_master_password_atau_app_password

# Alamat pengirim default yang tampil di inbox penerima
# Format: Nama Pengirim <email@domain.com>
# Pastikan alamat email di bawah ini sudah dideklarasikan dan diverifikasi sebagai Sender di Brevo.
MAIL_DEFAULT_SENDER=Toko Sembako <noreply@tokosembako.com>

# --- Fitur Tambahan (Development) ---
# Jika diisi, semua email keluar akan diarahkan ke alamat ini (sangat berguna untuk tes pengiriman lokal)
# Kosongkan di production.
MAIL_REDIRECT_TO=
