# Konfigurasi Layanan Email Toko Sembako

# Provider: smtp, resend, brevo, atau console
# - console: Menyimpan/menyimulasikan email di log & database (untuk development)
# - smtp: Mengirim email nyata menggunakan server SMTP (bisa diblokir oleh cloud provider seperti Railway)
# - resend: Mengirim email nyata menggunakan Resend HTTP API (sangat stabil untuk cloud hosting)
# - brevo: Mengirim email nyata menggunakan Brevo HTTP API (sangat stabil untuk cloud hosting)
MAIL_PROVIDER=console

# --- Konfigurasi HTTP API (Resend / Brevo) ---
# Diperlukan jika MAIL_PROVIDER=resend atau brevo
RESEND_API_KEY=re_your_api_key_here
BREVO_API_KEY=xkeysib-your_api_key_here

# --- Konfigurasi SMTP (Hanya jika MAIL_PROVIDER=smtp) ---
MAIL_SMTP_SERVER=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_USE_TLS=True

# Kredensial SMTP (Contoh untuk Gmail, gunakan App Password)
MAIL_USERNAME=email_anda@gmail.com
MAIL_PASSWORD=app_password_anda

# --- Pengirim Default ---
# Pengirim default yang muncul di email penerima.
# CATATAN untuk Resend: Jika memakai API Key testing, pengirim harus "onboarding@resend.dev".
# Untuk production, gunakan email dengan domain Anda yang sudah diverifikasi di Resend/Brevo.
MAIL_DEFAULT_SENDER=Toko Sembako <email_anda@gmail.com>

