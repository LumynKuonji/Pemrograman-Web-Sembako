# Konfigurasi Layanan Email Toko Sembako

# Provider: smtp atau console
# console: Menyimpan email sebagai file HTML di BackEnd/sent_emails/ (Sangat disarankan untuk development!)
# smtp: Mengirim email nyata menggunakan server SMTP
MAIL_PROVIDER=console

# Pengaturan SMTP (Hanya jika MAIL_PROVIDER=smtp)
MAIL_SMTP_SERVER=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_USE_TLS=True

# Kredensial SMTP (Contoh untuk Gmail, gunakan App Password)
MAIL_USERNAME=email_anda@gmail.com
MAIL_PASSWORD=app_password_anda

# Pengirim default yang muncul di email penerima
MAIL_DEFAULT_SENDER=Toko Sembako <email_anda@gmail.com>
