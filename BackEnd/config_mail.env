# Konfigurasi Layanan Email Toko Sembako
MAIL_PROVIDER=smtp

# Pengaturan SMTP (Diisi jika ingin mengirim email nyata)
MAIL_SMTP_SERVER=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_gmail@gmail.com
MAIL_PASSWORD=your_app_password_16_chars
MAIL_DEFAULT_SENDER=Toko Sembako <your_gmail@gmail.com>
