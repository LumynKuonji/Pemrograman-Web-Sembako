# ===================================
# EMAIL CONFIGURATION (Gmail SMTP)
# ===================================
# Cara membuat Gmail App Password:
# 1. Buka https://myaccount.google.com/security
# 2. Aktifkan "2-Step Verification" jika belum
# 3. Cari "App passwords" atau kunjungi https://myaccount.google.com/apppasswords
# 4. Pilih "Mail" dan "Other (Custom name)"
# 5. Beri nama "Toko Sembako"
# 6. Copy password 16 digit yang diberikan (tanpa spasi)
# 7. Paste ke MAIL_PASSWORD di bawah

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-digit-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# ===================================
# APPLICATION SETTINGS
# ===================================
SECRET_KEY=sembako-dev-secret-change-in-production
FLASK_ENV=development

# ===================================
# OTP SETTINGS
# ===================================
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
